<div id="loading-screen" class="loading-screen" role="status" aria-label="Now loading..." aria-live="polite">
  <span class="loading-caption" aria-hidden="true">Now loading...</span>
  <div class="loader loader--auto" aria-hidden="true">
    <span class="loader__eye"></span>
    <span class="loader__eye"></span>
  </div>
  <div class="loading-blink" aria-hidden="true"><span class="loading-blink__upper"></span><span class="loading-blink__lower"></span></div>
</div>
<noscript><style is:inline>.loading-screen{display:none}</style></noscript>
