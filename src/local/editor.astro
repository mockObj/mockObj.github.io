---
import SiteLayout from '../layouts/SiteLayout.astro';
import EditorHeader from '../components/editor/EditorHeader.astro';
import ImageWorkspace from '../components/editor/ImageWorkspace.astro';
import ImageLibrary from '../components/editor/ImageLibrary.astro';
import EditorFeedback from '../components/editor/EditorFeedback.astro';
import { exportSources, serializeForScript } from '../lib/export-sources';
import '../styles/editor.css';
---
<SiteLayout title="画像の編集 — eyes" mode="draft" robots="noindex,nofollow">
  <EditorHeader />
  <main>
    <p class="storage-note">編集内容はこのブラウザに保存されます。公開サイトの更新には「データを書出」で保存したJSONを使います。<a href="/content/me/">公開中のサイト ↗</a><a href="#registered-images">登録画像の一覧 ↓</a></p>
    <EditorFeedback />
    <div class="section-heading first-heading">
      <h1><span class="section-number">01</span>画像と目</h1>
      <div class="section-actions">
        <span class="draft-state" id="draft-state">画像を追加</span>
        <button class="text-button" id="new-image" type="button">新しい画像 <span aria-hidden="true">＋</span></button>
      </div>
    </div>
    <ImageWorkspace />
    <div class="section-heading placement-heading">
      <h2><span class="section-number">02</span>登録画像</h2>
      <p>配置は自動。画像をクリックして編集。</p>
    </div>
    <ImageLibrary />
    <div class="status-bar" id="status-bar" role="status" aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <p id="status-message">画像を取り込み、円で目の範囲を指定してください。</p>
    </div>
  </main>
  <footer class="page-footer"><span>下書きはこのブラウザに保存。バックアップには「データを書出」を使ってください。</span></footer>
  <input id="image-file-input" type="file" accept="image/*" multiple hidden />
  <input id="data-file-input" type="file" accept="application/json,.json" hidden />
  <script type="application/json" id="me-export-sources" set:html={serializeForScript(exportSources)} />
</SiteLayout>
<script>
  import '../scripts/editor.js';
</script>
<style>
  .storage-note { margin: 20px 4.5vw 0; color: var(--quiet); line-height: 1.8; }
  .storage-note a { text-decoration: underline; margin-left: 12px; }
</style>
