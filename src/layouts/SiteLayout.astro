---
interface Props {
  title?: string;
  mode?: 'public' | 'draft';
  robots?: string;
}
const { title = 'eyes', mode = 'public', robots } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja" data-me-portable={mode} data-me-root="/content/me/">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content="目を集める、終わりのない空間。" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
